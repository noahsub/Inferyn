<UserControl
    d:DesignHeight="75"
    d:DesignWidth="520"
    mc:Ignorable="d"
    x:Class="Inferyn.Controls.Server"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="ComponentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
        </Grid.ColumnDefinitions>
        <Border
            Background="{StaticResource WindowBackground}"
            CornerRadius="10 10 10 10"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            x:Name="BackgroundBorder" />
        <Ellipse
            Fill="{StaticResource Accent}"
            Grid.Column="0"
            Height="15"
            VerticalAlignment="Center"
            Width="15"
            x:Name="ServerStatus" />
        <Label
            Content="localhost"
            Grid.Column="1"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            x:Name="ServerName" />
        <StackPanel
            Grid.Column="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="2">
            <Label
                Content="1"
                VerticalAlignment="Center"
                x:Name="Ping" />
            <Label Content="ms" VerticalAlignment="Center" />
        </StackPanel>
        <Button
            Classes="NavButton"
            Click="Button_OnClick"
            Content="&#xe5c5;"
            Grid.Column="3"
            HorizontalAlignment="Center" />
        <!--  Popup  -->
        <Popup
            Closed="OptionsPopup_OnClosed"
            IsLightDismissEnabled="True"
            Opened="OptionsPopup_OnOpened"
            PlacementMode="BottomEdgeAlignedLeft"
            x:Name="OptionsPopup">
            <Border
                Background="{StaticResource WindowBackground}"
                CornerRadius="0 0 10 10"
                Width="{Binding Bounds.Width, ElementName=ComponentGrid}">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Text="Server Info" />
                    <TextBlock Text="More details here..." />
                    <Separator />
                    <Button Content="Disconnect" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
