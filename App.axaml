<Application
    RequestedThemeVariant="Dark"
    x:Class="Inferyn.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options.  -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <FontFamily x:Key="JetBrainsMono">avares://Inferyn/Assets/Fonts#JetBrains Mono</FontFamily>
        <FontFamily x:Key="Inter">avares://Inferyn/Assets/Fonts#Inter</FontFamily>
        <FontFamily x:Key="MaterialSymbolsOutlined">avares://Inferyn/Assets/Fonts/MaterialSymbolsOutlined.ttf#Material Symbols Outlined</FontFamily>
        <FontFamily x:Key="MaterialSymbolsRounded">avares://Inferyn/Assets/Fonts/MaterialSymbolsRounded.ttf#Material Symbols Rounded</FontFamily>
        <FontFamily x:Key="MaterialSymbolsSharp">avares://Inferyn/Assets/Fonts/MaterialSymbolsSharp.ttf#Material Symbols Sharp</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <!--  Button Styles  -->
        <!-- <Style Selector="Button"> -->
        <!--     <Setter Property="FontFamily" Value="{StaticResource Inter}" /> -->
        <!--     <Setter Property="Background" Value="Transparent" /> -->
        <!--     <Setter Property="BorderBrush" Value="Transparent" /> -->
        <!--     ~1~ <Setter Property="Foreground" Value="{StaticResource PrimaryText}" /> @1@ -->
        <!--     ~1~ <Setter Property="CornerRadius" Value="{StaticResource Radius}" /> @1@ -->
        <!-- </Style> -->
        <!-- <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"> -->
        <!--     <Setter Property="Background" Value="{StaticResource Accent}" /> -->
        <!--     <Setter Property="Foreground" Value="{StaticResource PanelBackground}" /> -->
        <!-- </Style> -->

        <!--  Nav Button Styles  -->
        <Style Selector="Button.NavButton">
            <Setter Property="FontFamily" Value="{StaticResource MaterialSymbolsOutlined}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <!--  Primary Button Styles  -->
        <Style Selector="Button.PrimaryButton">
            <Setter Property="FontFamily" Value="{StaticResource Inter}" />
            <!-- <Setter Property="FontWeight" Value="SemiBold" /> -->
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="{StaticResource ComponentBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        </Style>

        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>

        <!--  Label Styles  -->
        <Style Selector="Label">
            <Setter Property="FontFamily" Value="{StaticResource Inter}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!--  Tab Control Styles  -->
        <Style Selector="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource Inter}" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="{StaticResource Accent}" />
        </Style>

        <!--  TextBox Styles  -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource Inter}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="{StaticResource ComponentBackground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadius}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="{StaticResource Inter}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </Application.Styles>
</Application>